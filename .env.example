# Local settings for the admin panel and local pipeline test runs. Copy to .env (never commit .env).
# The live data runs on GitHub read the same names from the repository's Actions secrets instead.

# RetroAchievements: retroachievements.org → Settings → Keys
RA_USERNAME=
RA_API_KEY=

# Steam: steamcommunity.com/dev/apikey, and your 17-digit SteamID64
STEAM_API_KEY=
STEAM_USER_ID=

# Xbox (OpenXBL): xbl.io → sign in with your Microsoft account → API key
XBOX_API_KEY=
XBOX_XUID=

# Optional: SteamGridDB key for picking art in the admin (steamgriddb.com → Preferences → API)
SGDB_API_KEY=

# Optional: start data runs from the admin, or from cron-job.org (a fine-grained token with
# Actions: read and write on this repository), and manage the cron-job.org jobs from the admin
GH_DISPATCH_TOKEN=
CRON_JOB_API_KEY=

# Optional: worked out from the git remote when empty
GITHUB_REPOSITORY=
SITE_URL=
